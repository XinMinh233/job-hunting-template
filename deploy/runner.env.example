# 复制为 /etc/jobhunt/runner.env，权限 root:root 0600。
# Runner 不需要、也不应拥有真实 DeepSeek Key 或 Web 签名密钥。
JOBHUNT_RUNNER_SOCKET=/run/jobhunt/runner.sock
JOBHUNT_RUNNER_REGISTRY=/var/lib/jobhunt-runner/registry.json
JOBHUNT_USERS_ROOT=/var/lib/jobhunt/users
JOBHUNT_STAGING_ROOT=/var/lib/jobhunt-staging
JOBHUNT_TEMPLATE_ROOT=/opt/jobhunt/app
JOBHUNT_PROXY_BASE_URL=http://127.0.0.1:8000/internal/deepseek/anthropic
JOBHUNT_PRIMARY_MODEL=deepseek-v4-pro[1m]
JOBHUNT_LIGHT_MODEL=deepseek-v4-flash
JOBHUNT_EFFORT_LEVEL=max
JOBHUNT_CLAUDE_BIN=/usr/local/bin/claude
JOBHUNT_CLAUDE_VERSION=2.1.197
JOBHUNT_WEB_GROUP=jobhunt-web
