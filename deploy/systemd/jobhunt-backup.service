[Unit]
Description=求职系统 Restic 加密备份
After=jobhunt-web.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/jobhunt/restic.env
ExecStart=/opt/jobhunt/app/deploy/scripts/backup.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/cache/restic /var/cache/jobhunt-backup
ReadOnlyPaths=/var/lib/jobhunt/app /var/lib/jobhunt/users /var/lib/jobhunt-runner
