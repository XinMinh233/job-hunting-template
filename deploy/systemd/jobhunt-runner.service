[Unit]
Description=求职系统受限 Root Runner
After=local-fs.target
Before=jobhunt-web.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/jobhunt/app
EnvironmentFile=/etc/jobhunt/runner.env
ExecStartPre=/usr/bin/install -d -o root -g jobhunt-web -m 0750 /run/jobhunt
ExecStart=/opt/jobhunt/venv/bin/jobhunt-runner
Restart=on-failure
RestartSec=3
UMask=0077
PrivateTmp=yes
PrivateDevices=no
ProtectHome=yes
ProtectSystem=full
ReadWritePaths=/etc -/run/jobhunt /var/lib/jobhunt/users /var/lib/jobhunt-runner /var/lib/jobhunt-staging
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
