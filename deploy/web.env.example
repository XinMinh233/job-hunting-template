# 复制为 /etc/jobhunt/web.env，权限 root:jobhunt-web 0640。
JOBHUNT_SECRET_KEY=请用-openssl-rand-hex-32-生成
JOBHUNT_DATABASE_URL=sqlite:////var/lib/jobhunt/app/jobhunt.sqlite3
JOBHUNT_COOKIE_SECURE=true
JOBHUNT_PUBLIC_BASE_URL=https://jobs.example.com
JOBHUNT_RUNNER_SOCKET=/run/jobhunt/runner.sock
JOBHUNT_STAGING_ROOT=/var/lib/jobhunt-staging
JOBHUNT_TEMPLATE_ROOT=/opt/jobhunt/app
JOBHUNT_PROXY_BASE_URL=http://127.0.0.1:8000/internal/deepseek/anthropic
JOBHUNT_GLOBAL_CONCURRENCY=3
JOBHUNT_DEFAULT_DAILY_JOBS=30
JOBHUNT_DEFAULT_DAILY_TOKENS=1000000
JOBHUNT_QUOTA_TIMEZONE=Asia/Shanghai
JOBHUNT_PRIMARY_MODEL=deepseek-v4-pro[1m]
JOBHUNT_LIGHT_MODEL=deepseek-v4-flash
JOBHUNT_EFFORT_LEVEL=max
JOBHUNT_CLAUDE_BIN=/usr/local/bin/claude
JOBHUNT_CLAUDE_VERSION=2.1.197

# 真实 DeepSeek Key 只放在 Web 服务环境文件中。
DEEPSEEK_API_KEY=sk-请替换
DEEPSEEK_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
