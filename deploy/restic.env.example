# 复制为 /etc/jobhunt/restic.env，权限 root:root 0600。
# 未配置并完成一次 check + restore 演练前，不得标记为生产完成。
# 腾讯云 COS 上海地域示例；桶名必须包含 APPID。
RESTIC_REPOSITORY=s3:https://cos.ap-shanghai.myqcloud.com/请替换完整桶名/jobhunt-restic
RESTIC_PASSWORD=请使用独立强密码
AWS_ACCESS_KEY_ID=请替换
AWS_SECRET_ACCESS_KEY=请替换
# 腾讯云 COS 上海地域为 ap-shanghai。
AWS_DEFAULT_REGION=ap-shanghai
# COS 新桶使用 virtual-hosted-style；其他 S3 服务可按需改为 auto 或 path。
RESTIC_S3_BUCKET_LOOKUP=dns
